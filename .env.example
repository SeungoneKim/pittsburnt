# Server-side environment for the FastAPI engine.
#
#   cp .env.example .env        # .env is gitignored
#   set -a; . ./.env; set +a    # export it into this shell
#   make api
#
# Everything below is OPTIONAL and only powers the "Add a solution (Beta)"
# panel. Without it nothing breaks: the panel falls back to cached example
# drafts that still demonstrate the whole evidence gate, and the core
# Crash -> Adjust -> Re-test loop never touches the network.

# Any OpenAI-compatible chat endpoint. Read by api/llm.py.
#
# THESE ARE SERVER-SIDE SECRETS. They must never be given a NEXT_PUBLIC_
# prefix or put in web/.env.local, because anything NEXT_PUBLIC_ is compiled
# into the browser bundle and is visible to everyone who opens the page.
IFM_BASE_URL=
IFM_API_KEY=
IFM_MODEL=k2-horizon
