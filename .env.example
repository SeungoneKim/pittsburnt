# Server-side environment for the FastAPI engine. Copy to .env and export it
# before `make api`; .env is gitignored.

# Optional, and only for the "Add a solution (Beta)" panel. Get one from
# Google AI Studio. WITHOUT IT EVERYTHING ELSE STILL WORKS: the Beta panel
# falls back to cached example drafts, and the Crash -> Adjust -> Re-test
# loop never touches the network.
#
# This is a SERVER-SIDE secret. It is read by api/gemini.py and must never be
# given a NEXT_PUBLIC_ prefix or put in web/.env.local, because anything
# NEXT_PUBLIC_ is compiled into the browser bundle and visible to every
# visitor.
GEMINI_API_KEY=

# Which Gemini model the Beta panel calls. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
