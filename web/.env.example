# Copy to .env.local and fill in. .env.local is gitignored.

# Optional. Without it the map renders via MapLibre on OpenStreetMap tiles;
# with it, Mapbox's Light style is used instead.
# MUST be a PUBLIC token (starts with "pk."). NEXT_PUBLIC_ variables are
# compiled into the browser bundle and are visible to anyone who opens the
# page, so never put a secret token (starts with "sk.") here.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Where the FastAPI engine lives. Defaults to http://localhost:8000.
# The app falls back to the static bundle in public/data if this is down.
NEXT_PUBLIC_API_URL=http://localhost:8000
